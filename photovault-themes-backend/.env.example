PUBLIC_PREFIX=/api/locker-theme/public

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false

# If DATABASE_URL is unset or blank, the app uses SQLite at ./app.db.
# DATABASE_URL=

# If S3 settings are incomplete, the app stores uploads in ./media.
STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

LOCAL_MEDIA_DIR=media
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=50
